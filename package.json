{
  "name": "seed-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel 'dev:*'",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:convex": "convex dev",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "bun run --parallel --no-exit-on-error 'typecheck:*'",
    "typecheck:web": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck:config": "tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:once": "bun run test",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "preview": "vite preview --config web/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:cloudflare": "bun ci && bun run build"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@base-ui/react": "^1.4.0",
    "@convex-dev/auth": "^0.0.91",
    "@fontsource-variable/inter": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.35.1",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "shadcn": "^4.2.0",
    "tailwindcss": "^4.2.2",
    "vite": "^7.3.2",
    "@convex-dev/eslint-plugin": "^1.2.2",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.4",
    "convex-test": "^0.0.49",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.5"
  },
  "packageManager": "bun@1.3.14"
}
